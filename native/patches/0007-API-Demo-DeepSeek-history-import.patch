diff --git a/runtime/bridge/dsh-go-bridge/lib/session-import.js b/runtime/bridge/dsh-go-bridge/lib/session-import.js
new file mode 100644
index 0000000..bd27999
--- /dev/null
+++ b/runtime/bridge/dsh-go-bridge/lib/session-import.js
@@ -0,0 +1,247 @@
+// Native import of chats exported from chat.deepseek.com (or any user/assistant transcript)
+// into real Sessions on this host, through the public sessionPersistence seam only.
+//
+//   GET  /dsh-go/v1/sessions/import   {supported, version: 1, format: 4}
+//   POST /dsh-go/v1/sessions/import   {source, workspaceId? | cwd?, conversations: [...]}
+//                                     -> {results: [{sourceId, status, sessionId?, code?}]}
+//
+// The browser parses the export file and sends normalized conversations in small batches:
+//   {sourceId, title, createdAt, updatedAt?, messages: [{role, text, think?, model?, time?}]}
+//
+// Each conversation becomes one closed Session log: completed turns of one user message and
+// one assistant step, a user-sourced title (so the title model never renames it), and an
+// ignorable `plugin:dsh-go/import` record naming where it came from. The Session id is derived
+// from (source, sourceId), so importing the same file again skips what is already here; a chat
+// the user deleted (a permanent tombstone under dsh-Go's safe deletion) imports again.
+// Imported assistant messages carry provider `deepseek-import` and no replay state: when the
+// user continues the chat, every adapter sends them as plain history.
+import { createHash, randomUUID } from "node:crypto";
+
+const ROOT = "/dsh-go/v1/sessions/import";
+const FORMAT = 4;
+const PROVIDER = "deepseek-import";
+const MAX_BODY = 8 * 1024 * 1024;
+const MAX_CONVERSATIONS = 50;
+const MAX_MESSAGES = 4000;
+const MAX_TEXT = 512 * 1024;
+const MAX_GENERATIONS = 64;
+const SOURCES = new Set(["deepseek", "chatgpt", "api-demo", "dsh-go", "other"]);
+
+const errorBody = (code, message) => ({ error: { code, message } });
+const isObject = (v) => typeof v === "object" && v !== null && !Array.isArray(v);
+const text = (v, max) => (typeof v === "string" && v.length <= max ? v : undefined);
+const time = (v) => (typeof v === "number" && Number.isFinite(v) && v > 0 && v < 8.64e15 ? Math.round(v) : undefined);
+const clean = (s) => s.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g, "");
+
+/**
+ * A stable UUID-shaped Session id for one source conversation. dsh-Go's safe deletion never
+ * reuses an id, so a chat deleted after import comes back under the next generation.
+ */
+export function importedSessionId(source, sourceId, generation = 0) {
+  const h = createHash("sha256").update(`dsh-go/import\u0000${source}\u0000${sourceId}${generation ? `\u0000${generation}` : ""}`).digest("hex");
+  return `${h.slice(0, 8)}-${h.slice(8, 12)}-8${h.slice(13, 16)}-${((parseInt(h[16], 16) & 3) | 8).toString(16)}${h.slice(17, 20)}-${h.slice(20, 32)}`;
+}
+
+/** Validates one conversation; returns it normalized or a reason string. */
+export function normalizeConversation(raw) {
+  if (!isObject(raw)) return "not an object";
+  const sourceId = text(raw.sourceId, 256);
+  if (!sourceId || /[\u0000-\u001f\u007f]/.test(sourceId)) return "sourceId";
+  if (!Array.isArray(raw.messages) || raw.messages.length === 0 || raw.messages.length > MAX_MESSAGES) return "messages";
+  const messages = [];
+  for (const m of raw.messages) {
+    if (!isObject(m) || (m.role !== "user" && m.role !== "assistant")) return "message role";
+    const body = text(m.text, MAX_TEXT);
+    const think = m.think === undefined ? "" : text(m.think, MAX_TEXT);
+    if (body === undefined || think === undefined) return "message text";
+    const model = text(m.model, 128);
+    // Same-role neighbours (an edited prompt, a reply split in two) merge into one message.
+    const last = messages.at(-1);
+    if (last && last.role === m.role) {
+      if (body.trim()) last.text = last.text ? `${last.text}\n\n${clean(body)}` : clean(body);
+      if (think) last.think = last.think ? `${last.think}\n\n${clean(think)}` : clean(think);
+      last.time ??= time(m.time);
+      continue;
+    }
+    messages.push({ role: m.role, text: clean(body), think: clean(think), model, time: time(m.time) });
+  }
+  if (!messages.some((m) => m.role === "user" && m.text.trim())) return "no user message";
+  const createdAt = time(raw.createdAt) ?? messages.find((m) => m.time)?.time ?? Date.now();
+  const updatedAt = Math.max(time(raw.updatedAt) ?? createdAt, createdAt);
+  const firstUser = messages.find((m) => m.role === "user" && m.text.trim()).text;
+  const title = clean((text(raw.title, 400) ?? "").replace(/\s+/g, " ").trim()).slice(0, 120)
+    || firstUser.replace(/\s+/g, " ").trim().slice(0, 30);
+  return { sourceId, title, createdAt, updatedAt, messages };
+}
+
+/**
+ * The stored events of one imported conversation (seq from 0), in DSH session format 4.
+ * Times are spread between createdAt and updatedAt when the export has no per-message time.
+ */
+export function importEvents(conv, { source, importedAt = Date.now(), uuid = randomUUID } = {}) {
+  const events = [];
+  // Each event takes its message's own time; messages the export did not date are spread
+  // evenly between createdAt and updatedAt. Times never go backwards.
+  const n = conv.messages.length;
+  const span = Math.max(conv.updatedAt - conv.createdAt, 0);
+  const dated = conv.messages.map((m, k) => m.time ?? conv.createdAt + Math.floor((span * k) / Math.max(n - 1, 1)));
+  let now = conv.createdAt;
+  const at = (t) => (now = Math.max(now, t));
+  const push = (type, data, extra) => {
+    events.push({ type, seq: events.length, time: now, data, ...extra });
+  };
+  push(`plugin:dsh-go/import`, { source, sourceId: conv.sourceId, importedAt, messages: conv.messages.length }, { ignorable: true });
+  let turn = 0;
+  for (let i = 0; i < conv.messages.length; i++) {
+    const m = conv.messages[i];
+    const user = m.role === "user" ? m : undefined;
+    at(dated[i]);
+    const reply = user ? (conv.messages[i + 1]?.role === "assistant" ? conv.messages[++i] : undefined) : m;
+    turn++;
+    push("turn/start", { turn });
+    push("step/start", { turn, step: 1 });
+    // Surface node 0 is reserved for the system prompt. An empty one is legal; the agent loop
+    // replaces it with the live prompt when the user continues the chat.
+    if (turn === 1) push("system/message", { turn, step: 1, message: { role: "system", id: uuid(), content: [], source: { kind: "system-prompt" } } }, { surfaceOp: "append" });
+    if (user) {
+      push("user/message", { role: "user", id: uuid(), content: [{ type: "text", text: user.text }], source: { kind: "user" } }, { surfaceOp: "append" });
+    }
+    if (reply && (reply.text.trim() || reply.think.trim())) {
+      const content = [];
+      if (reply.think.trim()) content.push({ type: "reasoning", text: reply.think });
+      if (reply.text.trim()) content.push({ type: "text", text: reply.text });
+      at(dated[i]);
+      push("assistant/message", {
+        turn, step: 1,
+        message: { role: "assistant", id: uuid(), content, source: { kind: "model", provider: PROVIDER, model: reply.model ?? "deepseek-chat" } },
+        stream: [],
+      }, { surfaceOp: "append" });
+    }
+    push("step/end", { turn, step: 1 });
+    push("turn/end", { turn, reason: { kind: "completed" } });
+  }
+  // A user-sourced title carries no messageSeqs (session-format rule), and the title model leaves it alone.
+  push("session/title", { title: conv.title, messageSeqs: [], source: { kind: "user" } });
+  return events;
+}
+
+export function createSessionImport(ctx, { readBody, send }) {
+  const seam = () => {
+    const persistence = ctx.get("sessionPersistence");
+    for (const m of ["create", "stat", "list", "open"]) if (typeof persistence?.[m] !== "function") return;
+    return { persistence, workspaces: ctx.get("workspaceRegistry") };
+  };
+  const exists = async (persistence, id) => {
+    try { return (await persistence.stat(id)) != null; }
+    catch (error) { if (/NotFound/.test(error?.name ?? "") || error?.code === "ENOENT") return false; throw error; }
+  };
+  const importOne = async ({ persistence }, raw, { source, cwd, workspace }) => {
+    const conv = normalizeConversation(raw);
+    const sourceId = isObject(raw) && typeof raw.sourceId === "string" ? raw.sourceId.slice(0, 256) : null;
+    if (typeof conv === "string") return { sourceId, status: "failed", code: "invalid", reason: conv };
+    const deleted = (id) => { try { return persistence.dshGoDeletion?.deleted?.(id) === true; } catch { return false; } };
+    let sessionId, generation = 0;
+    for (; generation < MAX_GENERATIONS; generation++) {
+      sessionId = importedSessionId(source, conv.sourceId, generation);
+      if (!deleted(sessionId)) break;
+    }
+    if (generation === MAX_GENERATIONS) return { sourceId, status: "failed", code: "too-many-deletions" };
+    if (await exists(persistence, sessionId)) return { sourceId, status: "skipped", sessionId };
+    let handle;
+    try {
+      handle = await persistence.create({ version: FORMAT, id: sessionId, createdAt: conv.createdAt, cwd, isSeeded: false, delegationDepth: 0 });
+    } catch (error) {
+      if (/AlreadyExists|AlreadyOwned/.test(error?.name ?? "")) return { sourceId, status: "skipped", sessionId };
+      throw error;
+    }
+    try {
+      await handle.append(importEvents(conv, { source }));
+      await handle.flush();
+    } finally {
+      await handle.close();
+    }
+    // Read the log back: the read path runs the format validator that append does not, and the
+    // folded projections seed the list cache so the title shows without opening the chat.
+    try {
+      const reader = await persistence.open(sessionId, "read");
+      try {
+        const { events } = await reader.read();
+        const stored = await persistence.stat(sessionId);
+        try { ctx.get("sessionProjectionCache")?.coldSnapshot(stored.header, 0, events); }
+        catch (error) { ctx.logger?.warn?.(`session import: projection cache: ${error?.name ?? "Error"}`); }
+      } finally {
+        await reader.close();
+      }
+    } catch (error) {
+      ctx.logger?.warn?.(`session import: read-back failed: ${error?.name ?? "Error"}: ${error?.message ?? error}`);
+      return { sourceId, status: "failed", sessionId, code: "verify-failed" };
+    }
+    if (workspace) {
+      try { await workspace.attachSession(sessionId); }
+      catch { return { sourceId, status: "imported", sessionId, code: "workspace-attach-failed" }; }
+    }
+    return { sourceId, status: "imported", sessionId };
+  };
+
+  return {
+    async handle(req, res, path) {
+      if (path !== ROOT) return false;
+      if (req.method === "GET") {
+        send(res, 200, { supported: seam() !== undefined, version: 1, format: FORMAT });
+        return true;
+      }
+      if (req.method !== "POST") {
+        req.resume();
+        send(res, 405, errorBody("method-not-allowed", "Use GET or POST."));
+        return true;
+      }
+      const services = seam();
+      if (!services) {
+        req.resume();
+        send(res, 503, errorBody("unavailable", "Session import is not available on this host."));
+        return true;
+      }
+      if (String(req.headers["content-type"]).split(";", 1)[0].trim().toLowerCase() !== "application/json") {
+        req.resume();
+        send(res, 415, errorBody("bad-request", "Content-Type must be application/json."));
+        return true;
+      }
+      let body;
+      try {
+        body = JSON.parse((await readBody(req, MAX_BODY)).toString("utf8"));
+      } catch (error) {
+        send(res, error?.status === 413 ? 413 : 400, errorBody(error?.status === 413 ? "too-large" : "bad-request", error?.status === 413 ? "Send fewer conversations per request." : "Body is not JSON."));
+        return true;
+      }
+      const source = SOURCES.has(body?.source) ? body.source : undefined;
+      if (!isObject(body) || !source || !Array.isArray(body.conversations) || body.conversations.length > MAX_CONVERSATIONS
+        || (body.workspaceId !== undefined && typeof body.workspaceId !== "string")
+        || (body.cwd !== undefined && typeof body.cwd !== "string") || (body.workspaceId !== undefined && body.cwd !== undefined)) {
+        send(res, 400, errorBody("bad-request", `Expected {source, workspaceId? | cwd?, conversations: [<= ${MAX_CONVERSATIONS}]}.`));
+        return true;
+      }
+      let workspace, cwd = body.cwd;
+      if (body.workspaceId !== undefined) {
+        workspace = services.workspaces?.get(body.workspaceId);
+        if (!workspace) {
+          send(res, 404, errorBody("workspace-not-found", "Workspace was not found."));
+          return true;
+        }
+        cwd = workspace.path;
+      }
+      cwd ??= process.cwd();
+      const results = [];
+      for (const raw of body.conversations) {
+        try {
+          results.push(await importOne(services, raw, { source, cwd, workspace }));
+        } catch (error) {
+          // Never send filesystem paths or engine stacks to clients.
+          ctx.logger?.warn?.(`session import: ${error?.name ?? "Error"}: ${error?.message ?? error}`);
+          results.push({ sourceId: isObject(raw) ? raw.sourceId ?? null : null, status: "failed", code: "write-failed" });
+        }
+      }
+      send(res, 200, { results });
+      return true;
+    },
+  };
+}
