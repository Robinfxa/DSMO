new file mode 100644
index 0000000..13cce2f
--- /dev/null
+++ b/runtime/tests/session-import-live.py
@@ -0,0 +1,124 @@
+# Live check of dsh-go-bridge's session import against a real DSH host and a fake DeepSeek model:
+# imported chats list with their titles and original dates (also after a restart), read back
+# without format errors, skip on re-import, and continue with the old turns as model history.
+#
+#   python3 runtime/tests/session-import-live.py --prefix <dir with node_modules/@deepseek-ai/dsh> --output <dir>
+import argparse, pathlib, tempfile, subprocess, os, time, re, urllib.request, urllib.error, json, socket, threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+ap = argparse.ArgumentParser(); ap.add_argument("--prefix", type=pathlib.Path, required=True); ap.add_argument("--output", type=pathlib.Path, required=True)
+a = ap.parse_args(); repo = pathlib.Path(__file__).resolve().parents[2]; a.output.mkdir(parents=True, exist_ok=True)
+BRIDGE = repo / "runtime/bridge/dsh-go-bridge/lib/index.js"
+DAY = 1772416800000  # 2026-03-02T10:00:00+08:00
+CONVERSATIONS = [
+  {"sourceId": "c1", "title": "周末去哪玩", "createdAt": DAY, "updatedAt": DAY + 300000, "messages": [
+    {"role": "user", "text": "周末在杭州有什么适合带父母去的地方？", "time": DAY},
+    {"role": "assistant", "text": "可以考虑西湖慢走、灵隐寺。", "think": "考虑老人体力……", "model": "deepseek-reasoner", "time": DAY + 60000},
+    {"role": "user", "text": "要避开人多的地方呢？", "time": DAY + 200000},
+    {"role": "assistant", "text": "九溪烟树，工作日上午人最少。", "time": DAY + 300000}]},
+  {"sourceId": "c2", "title": "", "createdAt": DAY - 86400000, "messages": [
+    {"role": "assistant", "text": "（开场白）"}, {"role": "user", "text": "番茄炒蛋先放哪个"}, {"role": "user", "text": "补一句"}, {"role": "user", "text": "没有回答"}]},
+]
+
+calls = []
+class Model(BaseHTTPRequestHandler):
+  def log_message(self, *args): pass
+  def do_POST(self):
+    calls.append(json.loads(self.rfile.read(int(self.headers["content-length"]))))
+    self.send_response(200); self.send_header("content-type", "text/event-stream"); self.end_headers()
+    def ev(t, d): self.wfile.write(f"event: {t}\ndata: {json.dumps({'type': t, **d})}\n\n".encode())
+    ev("message_start", {"message": {"id": "m", "type": "message", "role": "assistant", "model": "deepseek-flash", "content": [], "usage": {"input_tokens": 1, "output_tokens": 0}}})
+    ev("content_block_start", {"index": 0, "content_block": {"type": "text", "text": ""}})
+    ev("content_block_delta", {"index": 0, "delta": {"type": "text_delta", "text": "好的"}})
+    ev("content_block_stop", {"index": 0}); ev("message_delta", {"delta": {"stop_reason": "end_turn"}, "usage": {"output_tokens": 1}}); ev("message_stop", {})
+model = ThreadingHTTPServer(("127.0.0.1", 0), Model); threading.Thread(target=model.serve_forever, daemon=True).start()
+
+def free():
+  s = socket.socket(); s.bind(("127.0.0.1", 0)); p = s.getsockname()[1]; s.close(); return p
+
+class Host:
+  def __init__(self, home, n):
+    ws = home / "ws"; ws.mkdir(exist_ok=True); self.ws = str(ws)
+    off = [{"id": i, "disabled": True} for i in ["session-title-llm", "llm-pi-ai", "llm-deepseek-account", "session-telemetry-otel", "web-search-deepseek", "web-deepseek-api", "web-fetch-http", "tool-web"]]
+    patch = home / "patch.json"; patch.write_text(json.dumps(off + [
