+// dsh-go-bridge session import: the pure log builder and the route over a fake persistence seam.
+// The live counterpart (a real DSH host, fake model) is runtime/tests/session-import-live.py.
+import assert from 'node:assert/strict';
+import { Readable } from 'node:stream';
+import { test } from 'node:test';
+import { createSessionImport, importEvents, importedSessionId, normalizeConversation } from '../bridge/dsh-go-bridge/lib/session-import.js';
+
+const conv = {
+  sourceId: 'c1', title: '周末去哪玩', createdAt: Date.parse('2026-03-02T10:00:00+08:00'), updatedAt: Date.parse('2026-03-02T10:05:00+08:00'),
+  messages: [
+    { role: 'user', text: '周末在杭州有什么适合带父母去的地方？', time: Date.parse('2026-03-02T10:00:00+08:00') },
+    { role: 'assistant', text: '西湖慢走。', think: '考虑老人体力', model: 'deepseek-reasoner' },
+    { role: 'user', text: '要避开人多的地方呢？' },
+    { role: 'assistant', text: '九溪烟树。' },
+  ],
+};
+
+test('session ids are stable, UUID-shaped and per source', () => {
+  const id = importedSessionId('deepseek', 'c1');
+  assert.match(id, /^[0-9a-f]{8}-[0-9a-f]{4}-8[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/);
+  assert.equal(id, importedSessionId('deepseek', 'c1'));
+  assert.notEqual(id, importedSessionId('chatgpt', 'c1'));
+});
+
+test('normalize merges same-role neighbours, strips control characters and falls back for the title', () => {
+  const n = normalizeConversation({ sourceId: 'x', createdAt: 1000, messages: [
+    { role: 'user', text: 'a\u0000b' }, { role: 'user', text: 'c' }, { role: 'assistant', text: 'd' }] });
+  assert.deepEqual(n.messages.map((m) => [m.role, m.text]), [['user', 'ab\n\nc'], ['assistant', 'd']]);
+  assert.equal(n.title, 'ab c');
+  for (const [bad, reason] of [[null, 'not an object'], [{ messages: [{ role: 'user', text: 'x' }] }, 'sourceId'],
+    [{ sourceId: 'x', messages: [] }, 'messages'], [{ sourceId: 'x', messages: [{ role: 'system', text: 'x' }] }, 'message role'],
+    [{ sourceId: 'x', messages: [{ role: 'assistant', text: 'x' }] }, 'no user message']]) assert.equal(normalizeConversation(bad), reason);
+});
+
+test('the log is a closed, model-replayable Session in format 4', () => {
+  let n = 0;
+  const events = importEvents(normalizeConversation(conv), { source: 'deepseek', importedAt: 5, uuid: () => `id-${n++}` });
+  events.forEach((e, i) => assert.equal(e.seq, i));
+  for (let i = 1; i < events.length; i++) assert.ok(events[i].time >= events[i - 1].time, 'times never go backwards');
+  assert.deepEqual(events[0], { type: 'plugin:dsh-go/import', seq: 0, time: conv.createdAt, ignorable: true,
+    data: { source: 'deepseek', sourceId: 'c1', importedAt: 5, messages: 4 } });
+  const surface = events.filter((e) => e.surfaceOp === 'append');
+  assert.deepEqual(surface.map((e) => e.type), ['system/message', 'user/message', 'assistant/message', 'user/message', 'assistant/message']);
+  assert.deepEqual(surface[0].data.message.content, [], 'empty system head reserves surface node 0');
+  assert.deepEqual(events.filter((e) => e.type === 'turn/end').map((e) => e.data), [
+    { turn: 1, reason: { kind: 'completed' } }, { turn: 2, reason: { kind: 'completed' } }]);
+  const reply = surface[2].data;
+  assert.deepEqual(reply.message.content, [{ type: 'reasoning', text: '考虑老人体力' }, { type: 'text', text: '西湖慢走。' }]);
+  assert.deepEqual(reply.message.source, { kind: 'model', provider: 'deepseek-import', model: 'deepseek-reasoner' });
+  assert.equal(reply.message.source.replayState, undefined);
+  assert.deepEqual(events.at(-1).data, { title: '周末去哪玩', messageSeqs: [], source: { kind: 'user' } });
+  assert.equal(surface[1].time, conv.createdAt);
+  assert.equal(surface[4].time, conv.updatedAt, 'undated messages spread to updatedAt');
+});
+
+test('a reply without a question and a question without a reply each get their own turn', () => {
+  const events = importEvents(normalizeConversation({ sourceId: 'e', createdAt: 1, messages: [
+    { role: 'assistant', text: '开场白' }, { role: 'user', text: '问' }, { role: 'assistant', text: '', think: '' }, { role: 'user', text: '没回答' }] }), { source: 'deepseek' });
+  // An empty reply is dropped; its question still closes as a completed turn.
+  const turns = [];
+  for (const e of events) {
+    if (e.type === 'turn/start') turns.push([]);
+    if (e.surfaceOp === 'append' && e.type !== 'system/message') turns.at(-1).push(e.data.message?.role ?? e.data.role);
+  }
+  assert.deepEqual(turns, [['assistant'], ['user'], ['user']]);
+});
+
+// ---------------------------------------------------------------- route
+
+function fakeHost({ corrupt = false } = {}) {
+  const stored = new Map(), attached = [], cached = [];
+  const persistence = {
+    async stat(id) { if (!stored.has(id)) throw Object.assign(new Error('missing'), { name: 'SessionPersistenceNotFoundError' }); return { header: stored.get(id).header }; },
+    async list() { return [...stored.values()].map((s) => ({ header: s.header })); },
+    async create(header) {
+      if (stored.has(header.id)) throw Object.assign(new Error('exists'), { name: 'SessionAlreadyExistsError' });
+      const s = { header, events: [] }; stored.set(header.id, s);
+      return { append: async (ev) => { s.events.push(...ev); }, flush: async () => {}, close: async () => {} };
+    },
+    async open(id) {
+      if (corrupt) throw Object.assign(new Error('bad'), { name: 'SessionPersistenceCorruptionError' });
+      return { read: async () => ({ events: stored.get(id).events }), close: async () => {} };
+    },
+  };
+  const workspace = { path: '/w/1', attachSession: async (id) => { attached.push(id); } };
+  const services = { sessionPersistence: persistence, workspaceRegistry: { get: (id) => (id === 'w1' ? workspace : undefined) },
+    sessionProjectionCache: { coldSnapshot: (header, n, events) => cached.push([header.id, n, events.length]) } };
+  const ctx = { get: (name) => services[name], logger: { warn() {} } };
+  return { ctx, stored, attached, cached };
+}
+const readBody = async (req) => Buffer.concat(await req.toArray());
+function route(host) {
+  let last;
+  const r = createSessionImport(host.ctx, { readBody, send: (_res, status, json) => { last = { status, json }; } });
+  return async (method, body, type) => { await r.handle(Object.assign(Readable.from(body === undefined ? [] : [Buffer.from(typeof body === 'string' ? body : JSON.stringify(body))]), { method, headers: { 'content-type': type ?? 'application/json' } }), {}, '/dsh-go/v1/sessions/import'); return last; };
+}
+
+test('route: capability, import, read-back into the list cache, and re-import skips', async () => {
+  const host = fakeHost(), post = route(host);
+  assert.deepEqual(await post('GET'), { status: 200, json: { supported: true, version: 1, format: 4 } });
+  const first = await post('POST', { source: 'deepseek', workspaceId: 'w1', conversations: [conv, { sourceId: 'bad', messages: [] }] });
+  assert.equal(first.status, 200);
+  const id = importedSessionId('deepseek', 'c1');
+  assert.deepEqual(first.json.results, [{ sourceId: 'c1', status: 'imported', sessionId: id }, { sourceId: 'bad', status: 'failed', code: 'invalid', reason: 'messages' }]);
+  assert.deepEqual(host.stored.get(id).header, { version: 4, id, createdAt: conv.createdAt, cwd: '/w/1', isSeeded: false, delegationDepth: 0 });
+  assert.deepEqual(host.attached, [id]);
+  assert.deepEqual(host.cached, [[id, 0, host.stored.get(id).events.length]]);
+  const again = await post('POST', { source: 'deepseek', workspaceId: 'w1', conversations: [conv] });
+  assert.deepEqual(again.json.results, [{ sourceId: 'c1', status: 'skipped', sessionId: id }]);
+});
+
+test('route: a chat deleted under dsh-Go safe deletion imports again under the next generation', async () => {
+  const host = fakeHost(), post = route(host);
+  const first = importedSessionId('deepseek', 'c1');
+  host.ctx.get('sessionPersistence').dshGoDeletion = { deleted: (id) => id === first };
+  host.stored.delete(first);
+  const r = await post('POST', { source: 'deepseek', cwd: '/w', conversations: [conv] });
+  assert.deepEqual(r.json.results, [{ sourceId: 'c1', status: 'imported', sessionId: importedSessionId('deepseek', 'c1', 1) }]);
+  assert.notEqual(importedSessionId('deepseek', 'c1', 1), first);
+});
+
+test('route: refuses bad requests and reports logs the host cannot read back', async () => {
+  const post = route(fakeHost());
+  assert.equal((await post('PUT')).status, 405);
+  assert.equal((await post('POST', '{}', 'text/plain')).status, 415);
+  assert.equal((await post('POST', 'not json')).status, 400);
+  assert.equal((await post('POST', { source: 'evil', conversations: [] })).status, 400);
+  assert.equal((await post('POST', { source: 'deepseek', cwd: '/x', workspaceId: 'w1', conversations: [] })).status, 400);
+  assert.equal((await post('POST', { source: 'deepseek', conversations: Array(51).fill(conv) })).status, 400);
+  assert.equal((await post('POST', { source: 'deepseek', workspaceId: 'nope', conversations: [] })).status, 404);
+  const broken = route(fakeHost({ corrupt: true }));
+  const r = await broken('POST', { source: 'deepseek', cwd: '/w', conversations: [conv] });
+  assert.equal(r.json.results[0].code, 'verify-failed');
+});
+
+test('route: unavailable without a persistence seam', async () => {
+  const post = route({ ctx: { get: () => undefined } });
+  assert.deepEqual((await post('GET')).json.supported, false);
+  assert.equal((await post('POST', { source: 'deepseek', conversations: [] })).status, 503);
+});
