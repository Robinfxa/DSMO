From 22843ee17b920a6ccc8f4d9c74c2e86676cc807c Mon Sep 17 00:00:00 2001
From: DSMO <dsmo@users.noreply.github.com>
Date: Wed, 18 Nov 2026 22:47:59 -0500
Subject: [PATCH 09/12] DSMO: no usage statistics

dsh-Go's statistics go to its own server (go.dshtui.com). DSMO counts and
reports nothing unless a build names its own endpoint with
--dart-define=DSH_USAGE_ENDPOINT=; the welcome page then shows the switch
again (the bridge reports usage.available).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EvNzunV3oTNc3v18wvhEA9
---
 app/lib/usage/usage_net.dart | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/app/lib/usage/usage_net.dart b/app/lib/usage/usage_net.dart
index b456738d..8cbf6657 100644
--- a/app/lib/usage/usage_net.dart
+++ b/app/lib/usage/usage_net.dart
@@ -6,7 +6,6 @@ import 'dart:async';
 import 'dart:convert';
 import 'dart:io';
 
-import 'package:flutter/foundation.dart';
 import 'package:flutter/services.dart';
 
 import '../state/app_info.dart';
@@ -31,11 +30,12 @@ Uri? usageEndpointFrom(String text) {
   return uri.scheme == 'https' || (uri.scheme == 'http' && loopback) ? uri : null;
 }
 
-/// Whether this build counts and reports at all: release builds, and builds
-/// pointed at a test endpoint. Debug runs and tests stay out of the numbers
-/// (tests switch it on where they check it).
+/// Whether this build counts and reports at all. DSMO: only a build pointed at
+/// its own endpoint (`--dart-define=DSH_USAGE_ENDPOINT=`); [defaultUsageEndpoint]
+/// is dsh-Go's server, so release builds send nothing there. Tests switch it on
+/// where they check it.
 abstract final class UsageBuild {
-  static bool active = kReleaseMode || usageEndpointFrom(_endpointOverride) != null;
+  static bool active = usageEndpointFrom(_endpointOverride) != null;
 }
 
 /// One POST; a seam so tests never touch the network.
