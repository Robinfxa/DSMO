Date: Wed, 18 Nov 2026 04:36:12 -0500
Subject: [PATCH 1/3] =?UTF-8?q?API=20Demo:=20bundled=20page=20as=20the=20h?=
 =?UTF-8?q?ome=20in=20=E7=BD=91=E9=A1=B5=E6=A8=A1=E5=BC=8F's=20place?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The web-mode slot of mode_home.dart shows ApiDemoHome (lib/api_demo/,
added by the overlay) instead of the official DSH Web, and web mode is the
default 界面. The native interface stays one switch away.
---
 app/lib/state/ui_mode_state.dart | 7 ++++---
 app/lib/ui/web/mode_home.dart    | 4 ++--
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/app/lib/state/ui_mode_state.dart b/app/lib/state/ui_mode_state.dart
index cea5bc0..1b58982 100644
--- a/app/lib/state/ui_mode_state.dart
+++ b/app/lib/state/ui_mode_state.dart
@@ -31,7 +31,7 @@ enum UiMode {
 
 /// The stored choice; [loaded] once read back at launch.
 class UiModeState {
-  const UiModeState({this.mode = UiMode.native, this.loaded = false});
+  const UiModeState({this.mode = UiMode.web, this.loaded = false});
 
   final UiMode mode;
   final bool loaded;
@@ -49,10 +49,11 @@ class UiModeController extends Notifier<UiModeState> {
   }
 
   Future<void> _load() async {
-    var mode = UiMode.native;
+    // API Demo: the bundled page (网页模式's seat) is the default home.
+    var mode = UiMode.web;
     try {
       final prefs = await SharedPreferences.getInstance();
-      mode = UiMode.values.asNameMap()[prefs.getString(key)] ?? UiMode.native;
+      mode = UiMode.values.asNameMap()[prefs.getString(key)] ?? UiMode.web;
     } catch (_) {
       // No preferences backend (tests) or an unreadable store: native.
     }
diff --git a/app/lib/ui/web/mode_home.dart b/app/lib/ui/web/mode_home.dart
index 2074503..ff8d730 100644
--- a/app/lib/ui/web/mode_home.dart
+++ b/app/lib/ui/web/mode_home.dart
@@ -17,7 +17,7 @@ import '../shell/home_shell.dart';
 import '../shell/page_frame.dart';
 import '../theme/app_icons.dart';
 import '../theme/theme.dart';
-import 'web_home.dart';
+import '../../api_demo/api_demo_home.dart';
 import 'web_target.dart';
 
 /// The app's home in the chosen 界面.
@@ -56,7 +56,7 @@ class _ModeHomeState extends ConsumerState<ModeHome> {
     final Widget home = mode.web
         ? KeyedSubtree(
             key: const ValueKey(UiMode.web),
-            child: widget.web?.call(_handoff) ?? WebHome(initial: _handoff),
+            child: widget.web?.call(_handoff) ?? ApiDemoHome(initial: _handoff),
           )
         : KeyedSubtree(key: const ValueKey(UiMode.native), child: widget.native ?? const HomeShell());
     // A launch into 伙伴 or 酒馆 opens that page over the home first.
