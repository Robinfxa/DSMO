From 83227f26c3c402876110c008adf7e377a2edcbd4 Mon Sep 17 00:00:00 2001
From: API Demo <api-demo@users.noreply.github.com>
Date: Wed, 18 Nov 2026 14:46:12 -0500
Subject: [PATCH 05/12] API Demo: DS Bot notification taps can be taken by the
 app's home

A hook before openDsBotTap pushes dsh-Go's own Bot pages, so the bundled
page can open the Bot or group itself.
---
 app/lib/ui/bots/bot_alerts.dart | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/app/lib/ui/bots/bot_alerts.dart b/app/lib/ui/bots/bot_alerts.dart
index 51c1f06a..fc0bbdc0 100644
--- a/app/lib/ui/bots/bot_alerts.dart
+++ b/app/lib/ui/bots/bot_alerts.dart
@@ -46,11 +46,15 @@ class _BotAlertsHostState extends ConsumerState<BotAlertsHost> with WidgetsBindi
   }
 }
 
+/// Takes DS Bot taps before the pages below would (API Demo opens its own); true when taken.
+bool Function(NotifyTap tap)? dsBotTapHandler;
+
 /// Opens the Bot or group a tapped notification names; false for any other
 /// notification, which the chat handles.
 bool openDsBotTap(BuildContext context, NotifyTap tap) {
   final kind = tap.kind;
   if (kind != dsBotTapBot && kind != dsBotTapRoom) return false;
+  if (dsBotTapHandler?.call(tap) ?? false) return true;
   final container = ProviderScope.containerOf(context, listen: false);
   container.read(activeHostProvider.notifier).select(tap.host);
   final navigator = Navigator.of(context, rootNavigator: true);
