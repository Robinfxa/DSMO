    {
      "tier": 2,
      "integrity": "sha256-TLaiR9WxVlH9X/myGqkHx1UiJDjvVqS/cRdwvT8AjMk=",
      "manifest": {
        "v": 1,
        "title": "常用提示词",
        "summary": "边栏多一个「常用提示词」，存 5 条自己的提示词，点一下放进输入框。",
        "kinds": [
          "slot",
          "panel"
        ],
        "permissions": [
