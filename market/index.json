      "tier": 2,
      "integrity": "sha256-TLaiR9WxVlH9X/myGqkHx1UiJDjvVqS/cRdwvT8AjMk=",
      "manifest": {
        "v": 1,
        "title": "常用提示词",
        "summary": "边栏多一个「常用提示词」，存 5 条自己的提示词，点一下放进输入框。",
        "kinds": [
          "slot",
          "panel"
        ],
        "permissions": [
          "storage"
        ],
        "slots": [
          {
            "slot": "sider.features",
            "id": "open",
            "title": "常用提示词",
            "icon": "FxSkill",
            "action": {
              "panel": "list"
            }
          }
        ],
        "panels": {
          "list": {
            "title": "常用提示词",
            "html": "<!doctype html>\n<meta charset=\"utf-8\">\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; padding: 4px 4px 8px; font: 15px/22px system-ui, -apple-system, \"PingFang SC\", sans-serif; color: var(--fg); background: transparent; }\n  button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }\n  .head { display: flex; align-items: center; justify-content: space-between; padding: 4px 12px 8px; color: var(--muted); font-size: 13px; }\n  .link { color: var(--brand); font-size: 15px; padding: 4px 0; }\n  .item { display: flex; align-items: center; gap: 4px; border-radius: 14px; }\n  .item .main { flex: 1; min-width: 0; text-align: left; padding: 10px 12px; border-radius: 14px; }\n  .item .main:active, .item .main:hover { background: var(--hover); }\n  .t { display: block; }\n  .p { display: block; color: var(--muted); font-size: 13px; line-height: 19px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }\n  .tool { width: 34px; height: 34px; border-radius: 17px; color: var(--muted); font-size: 16px; }\n  .tool:hover { background: var(--hover); }\n  .tool:disabled { opacity: .3; cursor: default; }\n  .tool.del { color: #e5484d; font-size: 14px; width: auto; padding: 0 10px; }\n  .editor { padding: 8px 12px 12px; }\n  input, textarea { width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 12px; background: var(--input); color: inherit; font: inherit; outline: none; }\n  textarea { height: 96px; margin-top: 8px; resize: vertical; }\n  .row { display: flex; justify-content: flex-end; gap: 16px; margin-top: 10px; }\n  .empty { padding: 18px 12px; color: var(--muted); }\n  .add { display: block; width: 100%; padding: 12px; text-align: left; color: var(--brand); }\n</style>\n<div class=\"head\"><span id=\"count\"></span><button class=\"link\" id=\"mode\">编辑</button></div>\n<div id=\"list\"></div>\n<script>\n  const MAX = 5;\n  const DEFAULTS = [\n    { t: '总结要点', p: '总结上面的对话，列三条要点。' },\n    { t: '改得更简洁', p: '把你上一条回答改写得更简洁，保留关键信息。' },\n    { t: '写成周报', p: '把我们这次做的事整理成一段周报，分「完成」「问题」「下周」三部分。' },\n    { t: '解释给新人', p: '用新人能听懂的话解释一遍，避免术语。' },\n    { t: '找出风险', p: '列出这个方案可能出问题的地方，以及怎么提前发现。' },\n  ];\n  let items = [];\n  let editing = false;\n  let open = -1; // index being edited; items.length = a new one\n\n  const el = (tag, cls, text) => { const n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; };\n  const save = () => apiDemo.storage.set('prompts', JSON.stringify(items));\n  const fit = () => requestAnimationFrame(() => apiDemo.resize(document.body.scrollHeight + 8));\n\n  function editor(i) {\n    const cur = items[i] || { t: '', p: '' };\n    const box = el('div', 'editor');\n    const t = el('input'); t.placeholder = '名称，例如「写成周报」'; t.maxLength = 20; t.value = cur.t;\n    const p = el('textarea'); p.placeholder = '提示词内容'; p.maxLength = 1000; p.value = cur.p;\n    const row = el('div', 'row');\n    const cancel = el('button', 'link', '取消');\n    const ok = el('button', 'link', '保存');\n    cancel.onclick = () => { open = -1; render(); };\n    ok.onclick = () => {\n      const v = { t: t.value.trim() || p.value.trim().slice(0, 10), p: p.value.trim() };\n      if (!v.p) return apiDemo.toast('提示词不能为空');\n      if (i < items.length) items[i] = v; else items.push(v);\n      open = -1; save(); render();\n    };\n    row.append(cancel, ok);\n    box.append(t, p, row);\n    setTimeout(() => (cur.t ? p : t).focus(), 0);\n    return box;\n  }\n\n  function render() {\n    const list = document.getElementById('list');\n    list.textContent = '';\n    document.getElementById('count').textContent = editing ? `最多 ${MAX} 条，可以改名、改内容、调整顺序` : '点一下放进输入框，不会自动发送';\n    document.getElementById('mode').textContent = editing ? '完成' : '编辑';\n    if (!items.length && open < 0) list.append(el('div', 'empty', '还没有提示词。'));\n    items.forEach((it, i) => {\n      if (open === i) return list.append(editor(i));\n      const row = el('div', 'item');\n      const main = el('button', 'main');\n      main.append(el('span', 't', it.t), el('span', 'p', it.p));\n      main.onclick = () => (editing ? ((open = i), render()) : apiDemo.insert(it.p).then(() => apiDemo.close()));\n      row.append(main);\n      if (editing) {\n        const up = el('button', 'tool', '↑'); up.setAttribute('aria-label', '上移'); up.disabled = i === 0;\n        const down = el('button', 'tool', '↓'); down.setAttribute('aria-label', '下移'); down.disabled = i === items.length - 1;\n        const del = el('button', 'tool del', '删除');\n        up.onclick = () => { [items[i - 1], items[i]] = [items[i], items[i - 1]]; save(); render(); };\n        down.onclick = () => { [items[i + 1], items[i]] = [items[i], items[i + 1]]; save(); render(); };\n        del.onclick = () => { items.splice(i, 1); save(); render(); };\n        row.append(up, down, del);\n      }\n      list.append(row);\n    });\n    if (open === items.length) list.append(editor(items.length));\n    else if (editing && items.length < MAX) {\n      const add = el('button', 'add', '＋ 添加提示词');\n      add.onclick = () => { open = items.length; render(); };\n      list.append(add);\n    }\n    fit();\n  }\n\n  document.getElementById('mode').onclick = () => { editing = !editing; open = -1; render(); };\n  apiDemo.ready().then(async () => {\n    try {\n      const raw = await apiDemo.storage.get('prompts');\n      const saved = raw ? JSON.parse(raw) : null;\n      items = Array.isArray(saved) ? saved.filter((x) => x && typeof x.p === 'string').slice(0, MAX) : DEFAULTS.slice();\n    } catch { items = DEFAULTS.slice(); }\n    render();\n  });\n</script>\n"
          }
        },
        "description": "在边栏打开「常用提示词」，点一条就放进输入框，不会替你发送。\n\n最多存 5 条。点「编辑」可以改名、改内容、上移下移和删除；内容只保存在这台设备上。",
        "highlights": [
          "最多 5 条，自己写",
          "改名、改内容、调整顺序",
          "只填进输入框，不自动发送"
        ],
        "id": "@api-demo/quick-prompts",
        "version": "1.1.0",
        "license": "MIT",
        "official": true
      }
    },
    {
      "tier": 2,
      "integrity": "sha256-77TYLN1gB/LuB1zS/ZUZcS/jf7x6wYVJoqxjIMlMKFk=",
      "manifest": {
        "v": 1,
        "title": "代码审查",
        "summary": "按清单审查改动：正确性、边界、安全、可读性、测试，问题按严重程度排序。",
        "permissions": [],
        "description": "装好后在输入框里输入 /code-review。没指定范围时，它先看工作区里未提交的改动或最近一次提交。\n\n问题按「必须改 → 建议改 → 小问题」排列，每条带位置和改法；默认不直接改文件。",
        "highlights": [
          "固定的五项清单",
          "每条问题带位置和改法",
          "默认只提意见，不改文件"
        ],
        "kinds": [
          "skill"
        ],
        "skills": [
          {
            "name": "code-review",
            "files": {
              "SKILL.md": "---\nname: code-review\ndescription: 按固定清单审查改动：正确性、边界条件、安全、可读性和测试，给出按严重程度排序的问题和改法。\n---\n\n# 代码审查\n\n审查用户指定的改动。没指定时，先在工作区里用 `git diff`（未提交的改动）或 `git diff HEAD~1` 看最近一次提交；改动太大时先问要看哪一部分。\n\n## 清单\n\n按顺序看，每一项只报真正的问题：\n\n1. **正确性**：逻辑错误、空值、越界、并发、错误处理吞掉了异常。\n2. **边界条件**：空输入、极大值、时区、编码、重复调用。\n3. **安全**：注入、路径穿越、把密钥写进代码或日志、权限检查缺失。\n4. **可读性**：命名、过长的函数、重复代码——只在明显影响维护时才提。\n5. **测试**：改动的行为有没有测试覆盖；缺了就写出该补的用例。\n\n## 输出\n\n- 先一句话总体结论（能合 / 改完再合 / 需要重做）。\n- 问题按严重程度排序：**必须改** → **建议改** → **小问题**。每条写：位置（文件:行）、问题、为什么、怎么改（给出改后的代码片段）。\n- 没发现问题的项不要硬凑。\n- 不要直接修改文件，除非用户要求。\n"
            }
          }
        ],
        "id": "@api-demo/skill-code-review",
        "version": "1.0.0",
        "license": "MIT",
        "official": true
      }
    },
    {
      "tier": 2,
      "integrity": "sha256-d7jy9SP5XEgKrBVJhuV9rK60zn3wAbCazc5q0TXEyKo=",
      "manifest": {
        "v": 1,
        "title": "会议纪要",
        "summary": "把会议记录、转写或群聊整理成纪要：结论、待办、待定问题。",
        "permissions": [],
        "description": "装好后在输入框里输入 /meeting-notes，再贴上会议记录、录音转写或群聊内容，AI 会整理成一份能直接发出去的纪要。\n\n只写材料里有的内容；没提到负责人或时间的待办会标「待定」，不会替人认领。",
        "highlights": [
          "结论、待办、待定问题三段",
          "待办写清谁、做什么、什么时候",
          "不编造材料里没有的内容"
        ],
        "kinds": [
          "skill"
        ],
        "skills": [
          {
            "name": "meeting-notes",
            "files": {
              "SKILL.md": "---\nname: meeting-notes\ndescription: 把会议记录、录音转写或聊天记录整理成会议纪要：结论、待办（负责人和截止时间）、待定问题。\n---\n\n# 会议纪要\n\n用户给你一段会议相关的原始材料（速记、录音转写、群聊记录、附件里的文本），把它整理成一份能直接发出去的纪要。\n\n## 步骤\n\n1. 通读材料，找出会议主题、参会人和日期；材料里没有的不要编，写「未注明」。\n2. 只保留**做出的决定**和**要做的事**，讨论过程一笔带过。\n3. 待办逐条写成「谁 · 做什么 · 什么时候」。没提到负责人或时间的，标「待定」，不要替人认领。\n4. 有分歧、没结论的放进「待定问题」。\n5. 不确定的地方用「（原文：……）」附上原话，方便核对。\n\n## 输出格式\n\n```\n# <主题> 会议纪要（<日期>）\n参会：……\n\n## 结论\n- ……\n\n## 待办\n| 负责人 | 事项 | 截止 |\n|---|---|---|\n\n## 待定问题\n- ……\n```\n\n篇幅控制在一屏内；用户要「详细版」再展开讨论过程。\n"
            }
          }
        ],
        "id": "@api-demo/skill-meeting-notes",
        "version": "1.0.0",
        "license": "MIT",
        "official": true
      }
    },
