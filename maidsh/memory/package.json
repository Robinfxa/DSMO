{
  "name": "maidsh-memory",
  "version": "0.2.1",
  "description": "MaiDSH·记忆：会自动记、会淡忘、带着感情的记忆，按话题自然想起，单独可用",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "companion",
    "deepseek-harness"
  ],
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robinfxa/DSMO.git",
    "directory": "maidsh/memory"
  }
}
